{
  "name": "nusscc-digital-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "test": "npm run test:unit && npm run test:component",
