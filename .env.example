# Public only after a non-production Supabase project is deliberately connected.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_ANON_KEY
# Server-only; never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVER_ONLY_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:LOCAL_PASSWORD@127.0.0.1:54322/postgres
